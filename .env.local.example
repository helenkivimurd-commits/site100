# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored — the keys below must never be committed or shared.
#
#   cp .env.local.example .env.local
#
# Restart `npm run dev` after changing anything here.

# --- Admin area (required) ---------------------------------------------------
# Guards /admin and the photo APIs behind it, including the one that serves
# unwatermarked originals. Without this set, the admin area stays locked.
#
# Your browser asks for it with its own login box — leave the username blank and
# type this as the password.
#
# Pick something long and random, not a word you also use elsewhere:
#     openssl rand -base64 24
#
# Server-only. It must NEVER be prefixed with NEXT_PUBLIC_ — that would send it
# to every visitor's browser.
ADMIN_PASSWORD=replace_me_with_a_long_random_password

# --- Stripe (required) -------------------------------------------------------
# Dashboard → Developers → API keys → "Secret key".
# Starts with sk_test_ while you're testing, sk_live_ once you go live.
# This is server-only. It must NEVER be prefixed with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_replace_me

# Verifies that incoming webhooks really came from Stripe.
# Local dev: run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#            and copy the whsec_ value it prints.
# Production: Dashboard → Developers → Webhooks → your endpoint → signing secret.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Where Stripe sends the customer back to. No trailing slash.
# Change to https://yourdomain.com when you deploy.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Email (optional) --------------------------------------------------------
# Without these, purchases still work and download links still appear on the
# success page — the confirmation email is simply skipped.
# Sign up at https://resend.com, then API Keys → Create.
RESEND_API_KEY=

# The "from" address. resend.dev works for testing without owning a domain.
# For real orders, verify your domain in Resend and use e.g. photos@yourdomain.com
EMAIL_FROM=h_kivimurd Photography <onboarding@resend.dev>
