[Unit]
Description=Back up the catalogue and orders every night

[Timer]
# Half past three in the morning, when nobody is uploading or tagging.
OnCalendar=*-*-* 03:30:00
# A machine that was off at 03:30 still gets its backup once it is on again.
Persistent=true
AccuracySec=5min
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
