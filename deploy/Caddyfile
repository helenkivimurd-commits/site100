# Deployed for helenkivimurd.com. To install:
#   sudo cp Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# Caddy obtains and renews the HTTPS certificate automatically. Nothing to do
# beyond pointing the domain's A record at this server first.

helenkivimurd.com, www.helenkivimurd.com {
	encode zstd gzip

	# Sets X-Forwarded-For and X-Forwarded-Proto, which the app's rate limiter
	# reads. Safe only because Node binds to 127.0.0.1 and cannot be reached
	# around this proxy — see deploy/hkp.service.
	reverse_proxy 127.0.0.1:3000

	# Admin login travels as Basic auth, which is reversible base64. HSTS stops
	# a browser being downgraded to http where it could be read off the wire.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# No body-size or read-timeout directive here on purpose. `timeouts` was
	# Caddy 1 syntax and Caddy 2 refuses to load a config containing it, so this
	# block stopped the web server starting at all. Caddy 2's defaults suit this
	# app anyway: it imposes no request body limit, so a 60MB photo upload gets
	# through, and paid downloads are redirects to B2 rather than bytes proxied
	# through Caddy, so slow phone connections never hold a connection open here.
}
