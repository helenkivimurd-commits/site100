[Unit]
Description=h_kivimurd Photography
After=network.target

[Service]
Type=simple
User=hkp
WorkingDirectory=/srv/hkp/site

Environment=NODE_ENV=production
Environment=PORT=3000

# -H 127.0.0.1 binds to loopback only, so the app is reachable *only* through
# Caddy. This is load-bearing: rate limiting and the client IP in the logs both
# trust the X-Forwarded-For header Caddy sets, and that header is forgeable by
# anyone who can reach Node directly. Do not change this to 0.0.0.0.
ExecStart=/usr/bin/node node_modules/.bin/next start -H 127.0.0.1

Restart=always
RestartSec=5

# One process, deliberately. photos.json and orders.json are guarded by
# in-memory write queues, and the rate limiter counts in memory too — a second
# process would corrupt the first and multiply the second. See ARCHITECTURE.md.

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The app writes order records and the watermarked previews under here. There
# is deliberately no Media path any more: full-resolution originals live in the
# B2 bucket, not on this disk. Listing a directory that does not exist makes
# systemd refuse to start the unit at all (status=226/NAMESPACE).
# ProtectSystem=strict makes the whole filesystem read-only for this service,
# so every directory it writes to must be listed here. Live data (the catalogue
# and the renders) lives outside /srv/hkp/site on purpose — see src/lib/storage.ts
# — and leaving those two paths off this line makes every upload and every bib
# edit fail with EROFS while the admin page still says "Saved".
ReadWritePaths=/srv/hkp/site /srv/hkp/data /srv/hkp/renders

[Install]
WantedBy=multi-user.target
