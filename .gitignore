node_modules/
.next/
out/
build/

# Secrets — API keys live here. Never commit this file.
.env
.env.local
.env*.local
# nano leaves .env.local.save on an interrupted edit, which the pattern above
# does not match — this catches every variant so no secrets can be committed.
.env*

# Order records and download tokens (generated at runtime)
.data/

# Runtime photo data. On the server these live outside the repo entirely (see
# CATALOGUE_FILE / RENDERS_DIR in src/lib/storage.ts); locally they land here.
# Ignored rather than merely untracked so that `git clean -fd` skips them too.
/public/photos/preview/
/public/photos/thumb/
/src/data/photos.json

*.tsbuildinfo
next-env.d.ts

.DS_Store
*.pem
npm-debug.log*
